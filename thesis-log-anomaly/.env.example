# Copy configuration into your shell or an ignored .env.llm file.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_ALLOW_EXTERNAL=0
LLM_CALL_CAP=2
LLM_INPUT_BUDGET=7000
LLM_VALIDATION_RETRIES=0
# Keep OPENAI_API_KEY in the process environment via your secret manager.

# Gemini 7B.1 smoke is disabled by default. Keep GEMINI_API_KEY in process environment.
LLM_GEMINI_FREE_TIER_CONFIRMED=
LLM_GEMINI_SMOKE_APPROVAL_ID=
LLM_GEMINI_SMOKE_EXPIRES_UTC=
LLM_GEMINI_SMOKE_TRACE_ID=
